{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "om-adf-demo"
		},
		"AzureTableStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureTableStorage1'"
		},
		"LS_Injest_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_Injest'"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://omstorageac.dfs.core.windows.net/"
		},
		"LS_Injest_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "om-sql-server-demo.database.windows.net"
		},
		"LS_Injest_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-dbom"
		},
		"LS_Injest_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "om1232"
		},
		"LS_outputService_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://omstorageac.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "om-adf-demo_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureTableStorage1_connectionString": {
						"value": "[parameters('AzureTableStorage1_connectionString')]"
					},
					"LS_Injest_password": {
						"value": "[parameters('LS_Injest_password')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"LS_Injest_properties_typeProperties_server": {
						"value": "[parameters('LS_Injest_properties_typeProperties_server')]"
					},
					"LS_Injest_properties_typeProperties_database": {
						"value": "[parameters('LS_Injest_properties_typeProperties_database')]"
					},
					"LS_Injest_properties_typeProperties_userName": {
						"value": "[parameters('LS_Injest_properties_typeProperties_userName')]"
					},
					"LS_outputService_properties_typeProperties_url": {
						"value": "[parameters('LS_outputService_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}