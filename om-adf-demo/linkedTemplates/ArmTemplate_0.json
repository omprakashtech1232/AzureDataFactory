			"name": "[concat(parameters('factoryName'), '/LS_Geng_to_reporting')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('LS_Geng_to_reporting_properties_typeProperties_url')]",
