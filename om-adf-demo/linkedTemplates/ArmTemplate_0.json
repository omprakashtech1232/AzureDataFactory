		"LS_sqlServer_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "om1232"
		},
		"Ls_Git_out_CSV_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://omstorageac.dfs.core.windows.net/"
