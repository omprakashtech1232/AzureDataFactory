{
	"name": "Union",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Ds_Delhi_csv",
						"type": "DatasetReference"
					},
					"name": "DelhiCSV"
				},
				{
					"dataset": {
						"referenceName": "DS_mumbai_CSv",
						"type": "DatasetReference"
					},
					"name": "Mumbai"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Ds_sink_outcome_csv",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          {month } as string,",
				"          sales as string,",
				"          profit as string,",
				"          location as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DelhiCSV",
				"source(output(",
				"          {month } as string,",
				"          sales as string,",
				"          profit as string,",
				"          location as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> Mumbai",
				"DelhiCSV, Mumbai union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          emp_id as string,",
				"          name as string,",
				"          salary as string,",
				"          address as string,",
				"          loc as string,",
				"          email as string,",
				"          user as string,",
				"          department as string,",
				"          designation as string",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}